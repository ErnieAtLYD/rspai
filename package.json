{
	"name": "retrospect-ai",
	"version": "1.0.0",
	"description": "Simple journal reflection summaries powered by AI. Transform your daily notes into meaningful insights.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"ai",
		"retrospective",
		"productivity",
		"analysis"
	],
	"author": "Ernie Hsiung",
	"license": "MIT",
	"devDependencies": {
		"@babel/core": "^7.28.0",
		"@babel/preset-env": "^7.28.0",
		"@types/jest": "^30.0.0",
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"babel-jest": "^30.0.4",
		"builtin-modules": "3.3.0",
		"esbuild": "^0.25.5",
		"jest": "^30.0.0",
		"obsidian": "latest",
		"ts-jest": "^29.4.0",
		"ts-node": "^10.9.2",
		"tslib": "2.4.0",
		"typescript": "^4.9.0"
	},
	"dependencies": {
		"compromise": "14.14.4",
		"natural": "8.1.0",
		"sentiment": "5.0.2"
	}
}
