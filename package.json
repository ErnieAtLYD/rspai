{
	"name": "retrospect-ai",
	"version": "1.0.0",
	"description": "Simple journal reflection summaries powered by AI. Transform your daily notes into meaningful insights.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "node esbuild.config.mjs production",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"deploy:test": "npm run build && cp main.js manifest.json .obsidian-test/.obsidian/plugins/retrospectai/",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"ai",
		"retrospective",
		"productivity",
		"analysis"
	],
	"author": "Ernie Hsiung",
	"license": "MIT",
	"devDependencies": {
		"@types/jest": "^30.0.0",
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"builtin-modules": "3.3.0",
		"esbuild": "^0.25.5",
		"jest": "^30.0.0",
		"obsidian": "latest",
		"ts-jest": "^29.4.0",
		"ts-node": "^10.9.2",
		"tslib": "2.4.0",
		"typescript": "^4.9.0"
	},
	"browser": {
		"obsidian": "./tests/mocks/obsidian.js"
	}
}
